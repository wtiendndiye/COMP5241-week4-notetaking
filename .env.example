OPENROUTER_API_KEY=your-openrouter-api-key
# Local SQLite is used when DATABASE_URL is unset.
# For local Neon testing, copy the connection string from the Neon Console.
# Keep this value private; configure it as a Vercel environment variable for deployment.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: defaults to nvidia/nemotron-3.5-lightning:free
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
